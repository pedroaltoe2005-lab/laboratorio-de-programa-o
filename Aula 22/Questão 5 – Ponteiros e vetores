#include <stdio.h>

int main() {
    int vetor[5];
    int *ptr = vetor;
    int i;

    printf("Digite 5 numeros inteiros:\n");
    for (i = 0; i < 5; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &vetor[i]);
    }

    printf("\nExibindo os elementos usando ponteiro:\n");
    for (i = 0; i < 5; i++) {
        printf("Elemento %d: %d\n", i + 1, *(ptr + i));
    }

    return 0;
}
