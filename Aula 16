#include <stdio.h>
#include <string.h>

int main() {
    char nome[100];

    printf("Digite seu nome completo: ");
    fgets(nome, sizeof(nome), stdin);

    // Remove a quebra de linha '\n' adicionada pelo fgets no final, se houver
    nome[strcspn(nome, "\n")] = '\0';

    printf("Nome completo digitado: %s\n", nome);
    return 0;
}

#include <stdio.h>

int main() {
    char palavra[100];
    int i, contador = 0;

    printf("Digite uma palavra: ");
    scanf("%s", palavra);

    // Percorre o vetor de caracteres at� encontrar o caractere nulo '\0'
    for (i = 0; palavra[i] != '\0'; i++) {
        contador++;
    }

    printf("A palavra digitada tem %d caracteres.\n", contador);
    return 0;
}

