#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    int matricula;
    char nome[100];
} Funcionario;

int main() {
    Funcionario func[5];
    FILE *arquivo;
    int i;

    printf("=== Cadastro de Funcionarios ===\n");
    
    for (i = 0; i < 5; i++) {
        printf("\n--- Funcionario %d ---\n", i + 1);
        printf("Digite a matricula: ");
        scanf("%d", &func[i].matricula);
        
        getchar(); 

        printf("Digite o nome: ");
        fgets(func[i].nome, sizeof(func[i].nome), stdin);
        func[i].nome[strcspn(func[i].nome, "\n")] = '\0';
    }

    arquivo = fopen("funcionarios.txt", "w");
    if (arquivo == NULL) {
        printf("\nErro ao abrir o arquivo para gravacao!\n");
        return 1;
    }

    for (i = 0; i < 5; i++) {
        fprintf(arquivo, "Matricula: %d | Nome: %s\n", func[i].matricula, func[i].nome);
    }

    fclose(arquivo);

    printf("\nDados gravados com sucesso no arquivo 'funcionarios.txt'!\n");

    return 0;
}
